const express=require("express"),http=require("http"),{Server}=require("socket.io"),crypto=require("crypto");
const app=express(),server=http.createServer(app),io=new Server(server);app.use(express.static("public"));
const rooms=new Map(),PORT=process.env.PORT||3000,ROUND=22,TOTAL=5;
const scenes=[
["The Foyer","🕯️","The front door slams shut. Rain claws at the windows. A floorboard creaks above you.","A muddy footprint points toward the portrait hall."],
["Portrait Hall","🖼️","The portraits seem to follow you. One painting has been turned to face the wall.","A strip of dark fabric is caught on a frame."],
["The Library","📚","Dust drifts through your flashlight beam. A book lies open, covered in frantic handwriting.","A note reads: One of us was already here."],
["The Basement","🔦","Pipes knock behind the walls. Something scrapes across the floor in the dark.","Fresh scratches mark the inside of a locked door."],
["The Nursery","🧸","A music box plays by itself. A rocking chair moves though the room is still.","A tiny key is hidden beneath the rocking chair."],
["The Mirror Room","🪞","Every mirror shows the room a second too late. A figure stands behind you—in one reflection.","One mirror shows a shadow that has no owner."],
["The Chapel","⛪","Candles flicker without wind. The house groans as if listening to your next decision.","A scratched symbol matches one on the front door."]
];
const survivor={investigate:["🔎","Investigate","Study the room for evidence."],search:["🗝️","Search","Look for supplies and an escape clue."],hide:["🫥","Hide","Keep out of sight and steady your nerves."],protect:["🛡️","Protect someone","Choose a player to watch over."],escape:["🚪","Work on escape","Try to unlock a way out."]};
const killer={stalk:["👁️","Stalk","Rattle a target's nerves."],trap:["🪤","Set a trap","Sabotage the current room."],plant:["🩸","Plant false evidence","Frame a living player."],strike:["🔪","Strike","Attack an unprotected target."],vanish:["🌑","Stay quiet","Avoid attention this round."]};
const alive=r=>[...r.players.values()].filter(p=>p.alive),survivors=r=>alive(r).filter(p=>p.role!=="killer"),name=(r,id)=>r.players.get(id)?.name||"Someone";
function snap(r){return {code:r.code,hostId:r.hostId,phase:r.phase,round:r.round,totalRounds:TOTAL,endsAt:r.endsAt,scene:r.scene,event:r.event,escape:r.escape,evidence:r.evidence.slice(-8),votes:r.phase==="voting"?Object.keys(r.votes).length:0,voteCount:r.phase==="voting"?alive(r).length:0,ending:r.ending,players:[...r.players.values()].map(p=>({id:p.id,name:p.name,alive:p.alive,health:p.health,sanity:p.sanity,submitted:p.submitted,evidenceCount:p.clues.length}))}}
function personal(r,id){let p=r.players.get(id);if(!p)return;io.to(id).emit("private",{role:p.role,clues:p.clues,inventory:p.inventory,notes:p.notes,actions:p.role==="killer"?killer:survivor,targets:[...r.players.values()].filter(x=>x.alive&&x.id!==id).map(x=>({id:x.id,name:x.name})),voted:!!r.votes[id]})}
function broadcast(r){io.to(r.code).emit("state",snap(r));for(const p of r.players.values())personal(r,p.id)}
function event(r,s){r.event=s}
function stop(r){if(r.timer)clearTimeout(r.timer);r.timer=null}
function timer(r,secs,fn){stop(r);r.endsAt=Date.now()+secs*1000;broadcast(r);r.timer=setTimeout(fn,secs*1000)}
function finish(r,winner,title,text){stop(r);r.phase="finished";r.endsAt=null;r.ending={winner,title,text};event(r,title);broadcast(r);io.to(r.code).emit("reveal",{killerId:r.killer,killerName:name(r,r.killer),ending:r.ending})}
function resolveVote(r){if(r.phase!=="voting")return;stop(r);let counts={};Object.values(r.votes).forEach(id=>counts[id]=(counts[id]||0)+1);let rank=Object.entries(counts).sort((a,b)=>b[1]-a[1]);if(rank[0]?.[0]===r.killer&&(!rank[1]||rank[0][1]>rank[1][1]))finish(r,"survivors","THE KILLER IS EXPOSED",`${name(r,r.killer)} was the killer. The survivors uncovered the truth.`);else if(r.escape>=3&&survivors(r).length)finish(r,"escape","THE DOOR OPENS","The accusation failed, but survivors found enough of the escape route to flee. The killer is still out there.");else finish(r,"killer","THE WRONG PERSON","The house swallowed the truth. The killer walks free.");}
function voting(r){r.phase="voting";r.votes={};event(r,"The house falls silent. Accuse the person you believe is the killer.");timer(r,25,()=>resolveVote(r))}
function resolveRound(r){if(r.phase!=="explore")return;stop(r);let k=r.players.get(r.killer);for(let p of alive(r))p.protected=false;
for(let p of survivors(r)){if(p.choice==="investigate"){let clue=r.scene[3];p.clues.push(clue);r.evidence.push({text:clue,by:p.name,round:r.round});event(r,`${p.name} uncovered a clue in ${r.scene[0]}.`)}else if(p.choice==="search"){if(Math.random()<.65){let item=["brass key","fuse","torn map"][Math.floor(Math.random()*3)];p.inventory.push(item);r.escape=Math.min(5,r.escape+1);event(r,`${p.name} found something useful.`)}else{p.sanity=Math.max(0,p.sanity-1);event(r,`${p.name} heard something behind the walls.`)}}else if(p.choice==="hide"){p.hidden=true;p.sanity=Math.min(3,p.sanity+1)}else if(p.choice==="escape"){if(p.inventory.length||Math.random()<.5)r.escape=Math.min(5,r.escape+1)}else if(p.choice==="protect"&&p.target){let t=r.players.get(p.target);if(t?.alive)t.protected=true}}
if(k?.alive){let t=r.players.get(k.target);if(k.choice==="stalk"&&t?.alive){t.sanity=Math.max(0,t.sanity-1);t.notes.push("You felt someone watching you.");event(r,"A cold presence moved through the house.")}else if(k.choice==="trap"){for(let p of survivors(r))if(p.choice==="investigate")p.sanity=Math.max(0,p.sanity-1);event(r,"A hidden trap snaps somewhere in the house.")}else if(k.choice==="plant"&&t?.alive){r.evidence.push({text:`A bloody thread was found near ${t.name}'s belongings.`,by:"Unknown",round:r.round});event(r,"Someone has tampered with the evidence.")}else if(k.choice==="strike"&&t?.alive){if(!t.protected&&!t.hidden){t.health--;t.sanity=Math.max(0,t.sanity-1);event(r,"A scream tears through the house. Someone has been attacked.");if(t.health<=0){t.alive=false;event(r,`${t.name} has been lost to the house.`)}}else{t.sanity=Math.max(0,t.sanity-1);event(r,"A struggle echoes through a nearby room.")}}}
for(let p of r.players.values()){p.submitted=false;p.choice=null;p.target=null;p.hidden=false;p.protected=false}
if(!survivors(r).length)return finish(r,"killer","THE HOUSE CLAIMS THEM ALL","The killer remains in the dark as the last light goes out.");
if(r.round>=TOTAL)return voting(r);r.phase="result";timer(r,4,()=>{r.round++;r.scene=scenes[(r.round-1)%scenes.length];r.phase="explore";event(r,"The house shifts around you. Decide who you can trust.");timer(r,ROUND,()=>resolveRound(r))})}
function add(r,id,n){r.players.set(id,{id,name:String(n||"Guest").trim().slice(0,18)||"Guest",role:null,alive:true,health:3,sanity:3,submitted:false,choice:null,target:null,clues:[],inventory:[],notes:[],hidden:false,protected:false})}
function reset(r){stop(r);r.phase="lobby";r.round=0;r.killer=null;r.ending=null;r.votes={};r.evidence=[];r.escape=0;r.scene=scenes[0];event(r,"The house is waiting. Invite at least two other players.");for(let p of r.players.values()){p.role=null;p.alive=true;p.health=3;p.sanity=3;p.submitted=false;p.choice=null;p.target=null;p.clues=[];p.inventory=[];p.notes=[]}broadcast(r)}
io.on("connection",s=>{
s.on("createRoom",d=>{let c;do{c=crypto.randomBytes(3).toString("hex").toUpperCase()}while(rooms.has(c));let r={code:c,hostId:s.id,players:new Map(),phase:"lobby",round:0,scene:scenes[0],event:"The house is waiting. Invite at least two other players.",evidence:[],escape:0,votes:{},ending:null,endsAt:null,timer:null,killer:null};rooms.set(c,r);add(r,s.id,d?.name);s.join(c);s.emit("joined",{code:c,id:s.id});broadcast(r)});
s.on("joinRoom",d=>{let r=rooms.get(String(d?.code||"").toUpperCase());if(!r)return s.emit("errorMessage","That room code was not found.");if(r.phase!=="lobby")return s.emit("errorMessage","That game has already started.");if(r.players.size>=12)return s.emit("errorMessage","This room is full.");add(r,s.id,d?.name);s.join(r.code);s.emit("joined",{code:r.code,id:s.id});event(r,`${name(r,s.id)} joined the house.`);broadcast(r)});
s.on("startGame",()=>{let r=[...rooms.values()].find(x=>x.players.has(s.id));if(!r||r.hostId!==s.id||r.phase!=="lobby")return;if(r.players.size<3)return s.emit("errorMessage","You need at least 3 players to begin.");let ps=[...r.players.values()];r.killer=ps[Math.floor(Math.random()*ps.length)].id;for(let p of ps){p.role=p.id===r.killer?"killer":"survivor";p.alive=true;p.health=3;p.sanity=3;p.clues=[];p.inventory=[];p.notes=[]}r.round=1;r.scene=scenes[0];r.escape=0;r.evidence=[];r.phase="explore";event(r,"The front door locks. One of you is hiding a terrible secret.");timer(r,ROUND,()=>resolveRound(r))});
s.on("submitAction",d=>{let r=[...rooms.values()].find(x=>x.players.has(s.id)),p=r?.players.get(s.id);if(!r||!p||r.phase!=="explore"||!p.alive||p.submitted)return;let opts=p.role==="killer"?killer:survivor;if(!opts[d?.action])return;p.choice=d.action;p.target=r.players.has(d.target)&&r.players.get(d.target).alive&&d.target!==p.id?d.target:null;if(["protect","stalk","plant","strike"].includes(p.choice)&&!p.target)return s.emit("errorMessage","Choose a target for that move.");p.submitted=true;broadcast(r);if(alive(r).every(x=>x.submitted))resolveRound(r)});
s.on("vote",target=>{let r=[...rooms.values()].find(x=>x.players.has(s.id)),p=r?.players.get(s.id),t=r?.players.get(target);if(!r||r.phase!=="voting"||!p?.alive||r.votes[s.id]||!t?.alive||t.id===p.id)return;r.votes[s.id]=target;broadcast(r);if(alive(r).every(x=>r.votes[x.id]))resolveVote(r)});
s.on("restartGame",()=>{let r=[...rooms.values()].find(x=>x.players.has(s.id));if(r&&r.hostId===s.id&&r.phase==="finished")reset(r)});
s.on("disconnect",()=>{for(let r of rooms.values())if(r.players.has(s.id)){let n=name(r,s.id);r.players.delete(s.id);if(!r.players.size){stop(r);rooms.delete(r.code);break}if(r.hostId===s.id)r.hostId=r.players.keys().next().value;if(r.phase==="explore"&&alive(r).length&&alive(r).every(p=>p.submitted))resolveRound(r);event(r,`${n} has left the house.`);broadcast(r);break}})
});
server.listen(PORT,()=>console.log("Haunted House V3 on "+PORT));
